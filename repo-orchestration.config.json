{
  "version": "2.0.0",
  "organization": "BlackRoad-OS",
  "repository": "blackroad-os-pack-education",
  "description": "Multi-repository communication and agent orchestration configuration",
  
  "crossRepositoryCommunication": {
    "enabled": true,
    "protocol": "https",
    "discovery": {
      "registry": "https://api.blackroad.io/registry",
      "heartbeat": 30,
      "timeout": 5000
    },
    "repositories": [
      {
        "name": "blackroad-os-core",
        "org": "BlackRoad-OS",
        "priority": "critical",
        "endpoints": ["https://api.blackroad.io/core"],
        "syncEnabled": true
      },
      {
        "name": "blackroad-os-api",
        "org": "BlackRoad-OS", 
        "priority": "critical",
        "endpoints": ["https://api.blackroad.io/api"],
        "syncEnabled": true
      },
      {
        "name": "blackroad-os-prism-console",
        "org": "BlackRoad-OS",
        "priority": "high",
        "endpoints": ["https://console.blackroad.io"],
        "syncEnabled": true
      },
      {
        "name": "blackroad-os-pack-*",
        "org": "BlackRoad-OS",
        "priority": "medium",
        "pattern": true,
        "syncEnabled": true
      }
    ],
    "events": {
      "publish": [
        "course.created",
        "course.updated",
        "lesson.completed",
        "assessment.graded",
        "agent.response",
        "workflow.completed"
      ],
      "subscribe": [
        "pack.update",
        "agent.broadcast",
        "system.alert",
        "sync.request"
      ]
    }
  },
  
  "agentOrchestration": {
    "enabled": true,
    "maxConcurrentAgents": 30000,
    "scalingStrategy": "distributed",
    
    "agentRegistry": {
      "local": "./agents",
      "remote": "https://agents.blackroad.io/registry",
      "syncInterval": 300
    },
    
    "loadBalancing": {
      "strategy": "round-robin",
      "healthCheck": true,
      "failover": true,
      "maxRetries": 3
    },
    
    "agentTypes": {
      "tutor": {
        "maxInstances": 10000,
        "priority": "high",
        "autoScale": true
      },
      "grader": {
        "maxInstances": 5000,
        "priority": "medium",
        "autoScale": true
      },
      "coach": {
        "maxInstances": 5000,
        "priority": "medium",
        "autoScale": true
      },
      "coordinator": {
        "maxInstances": 1000,
        "priority": "critical",
        "autoScale": false
      }
    },
    
    "communication": {
      "protocol": "event-driven",
      "messageQueue": "https://queue.blackroad.io",
      "pubsub": "https://pubsub.blackroad.io",
      "channels": [
        "agent.commands",
        "agent.responses",
        "agent.broadcasts",
        "agent.coordination"
      ]
    },
    
    "monitoring": {
      "enabled": true,
      "metricsEndpoint": "https://metrics.blackroad.io",
      "alerting": true,
      "dashboardUrl": "https://console.blackroad.io/agents"
    }
  },
  
  "automation": {
    "workflows": {
      "crossRepoSync": {
        "enabled": true,
        "schedule": "*/15 * * * *",
        "targets": ["all"]
      },
      "agentHealthCheck": {
        "enabled": true,
        "schedule": "*/5 * * * *"
      },
      "backupSync": {
        "enabled": true,
        "schedule": "0 * * * *"
      }
    },
    
    "triggers": {
      "onPush": {
        "notifyRepositories": true,
        "syncAgents": true,
        "runTests": true
      },
      "onIssue": {
        "notifyAgents": true,
        "autoAssign": true
      },
      "onPullRequest": {
        "notifyReviewers": true,
        "runChecks": true,
        "autoMerge": true
      }
    }
  },
  
  "security": {
    "authentication": {
      "required": true,
      "method": "token",
      "tokenEndpoint": "https://auth.blackroad.io"
    },
    "encryption": {
      "inTransit": true,
      "atRest": true,
      "algorithm": "AES-256"
    },
    "accessControl": {
      "enabled": true,
      "rbac": true,
      "defaultRole": "agent"
    }
  }
}
