        "lesson:bos-philosophy-intro",
        "lesson:bos-architecture-overview"
      ],
      "assessment": "assessment:bos-philosophy-quiz"
    },
    {
      "id": "module:bos-structure",
      "title": "Repository Structure & Packs",
      "description": "How BlackRoad OS is organized",
      "lessons": [
        "lesson:bos-repo-ecosystem",
        "lesson:bos-packs-intro",
        "lesson:bos-core-concepts"
      ],
      "assessment": "assessment:bos-structure-quiz"
    },
    {
      "id": "module:bos-building",
      "title": "Building with BlackRoad OS",
      "description": "Hands-on: Create flows and use schemas",
      "lessons": [
        "lesson:bos-schemas-intro",
        "lesson:bos-flows-intro",
        "lesson:bos-agents-intro"
      ],
      "assessment": "assessment:bos-building-project"
    }
  ],
